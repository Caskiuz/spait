// Esquema de datos de Sound Tech Peru.
// Ejecutar `npm run db:push` (prototipo) o `npm run db:migrate` (produccion).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===========================================================================
// Acceso y auditoria
// ===========================================================================

enum Role {
  ADMIN
  EDITOR
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploads     MediaAsset[]
  auditLogs   AuditLog[]
  notes       LeadNote[]

  @@index([email])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  diff      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ===========================================================================
// Medios
// ===========================================================================

model MediaAsset {
  id         String   @id @default(cuid())
  key        String?  @unique
  url        String
  pathname   String?
  alt        String
  width      Int?
  height     Int?
  size       Int?
  mimeType   String?
  folder     String   @default("general")
  uploadedBy String?
  uploader   User?    @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  serviceImages       ServiceImage[]
  serviceHeroes       Service[]        @relation("ServiceHeroImage")
  solutionCards       SolutionCard[]
  serviceApplications ServiceApplication[]
  courseCovers        Course[]
  courseFacilities    CourseFacility[]
  clientLogos         Client[]
  projectCovers       Project[]
  projectImages       ProjectImage[]
  galleryImages       GalleryImage[]
  testimonialAvatars  Testimonial[]
  pageHeroes          Page[]
  pageSections        PageSection[]
  faqImage            Faq?             @relation("FaqImage")

  @@index([folder])
}

// ===========================================================================
// Configuracion del sitio
// ===========================================================================

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id           String   @id @default(cuid())
  platform     String
  label        String
  url          String
  isFeatured   Boolean  @default(false)
  showInFooter Boolean  @default(true)
  order        Int      @default(0)
  note         String?
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([order])
}

// ===========================================================================
// Estructura de paginas
// ===========================================================================

enum SectionType {
  HERO
  SPLIT_ABOUT
  SERVICES_SHOWCASE
  ACADEMY_BANNER
  CLIENTS_CAROUSEL
  SOCIALS
  FAQ
  CTA
  TEXT_BLOCK
  GALLERY
  STATS
}

model Page {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  heroTitleLead String
  heroTitleAccent String
  heroSubtitle  String
  heroImageId   String?
  heroImage     MediaAsset?   @relation(fields: [heroImageId], references: [id], onDelete: SetNull)
  seoTitle      String?
  seoDescription String?
  isPublished   Boolean       @default(true)
  sections      PageSection[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model PageSection {
  id         String      @id @default(cuid())
  pageId     String
  page       Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type       SectionType
  /** Etiqueta interna para el editor del panel */
  label      String
  order      Int         @default(0)
  isVisible  Boolean     @default(true)
  data       Json
  imageId    String?
  image      MediaAsset? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([pageId, order])
}

// ===========================================================================
// Servicios
// ===========================================================================

enum ProjectScopeSize {
  PEQUENO
  MEDIANO
  GRANDE
}

enum ApplicationSide {
  IZQUIERDA
  DERECHA
}

model Service {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  titleLead      String
  titleAccent    String
  order          Int      @default(0)
  isFeatured     Boolean  @default(true)
  isPublished    Boolean  @default(true)
  areaLabel      String
  areaDescription String
  summary        String

  solutionsEyebrow  String?
  solutionsTitle    String
  solutionsSubtitle String?

  applicationsTitle    String?
  applicationsSubtitle String?

  scopeTitle String?
  scopeIntro String?

  ctaTitle       String
  ctaSubtitle    String
  ctaButtonLabel String @default("Solicitar información")

  keywords   String[] @default([])
  seoTitle   String?
  seoDescription String?

  heroImageId String?
  heroImage   MediaAsset? @relation("ServiceHeroImage", fields: [heroImageId], references: [id], onDelete: SetNull)

  paragraphs    ServiceParagraph[]
  images        ServiceImage[]
  solutions     ServiceSolution[]
  solutionCard  SolutionCard?
  applications  ServiceApplication[]
  applicationHighlight ServiceApplicationHighlight?
  scopeGroups   ServiceScopeGroup[]
  leadContacts  ContactMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model ServiceParagraph {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  text      String
  highlight Boolean @default(false)
  order     Int     @default(0)

  @@index([serviceId, order])
}

model ServiceImage {
  id        String     @id @default(cuid())
  serviceId String
  service   Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  mediaId   String
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  caption   String?
  order     Int        @default(0)

  @@index([serviceId, order])
}

model ServiceSolution {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  number    String
  title     String
  order     Int     @default(0)

  @@index([serviceId, order])
}

model SolutionCard {
  id          String     @id @default(cuid())
  serviceId   String     @unique
  service     Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  title       String
  accentWord  String?
  description String
  badgeValue  String     @default("10 años")
  badgeLabel  String     @default("de experiencia")
  imageId     String?
  image       MediaAsset? @relation(fields: [imageId], references: [id], onDelete: SetNull)
}

model ServiceApplication {
  id          String          @id @default(cuid())
  serviceId   String
  service     Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  title       String
  description String
  side        ApplicationSide @default(IZQUIERDA)
  emphasized  Boolean         @default(false)
  imageId     String?
  image       MediaAsset?     @relation(fields: [imageId], references: [id], onDelete: SetNull)
  order       Int             @default(0)

  @@index([serviceId, order])
}

model ServiceApplicationHighlight {
  id        String   @id @default(cuid())
  serviceId String   @unique
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  title     String
  bullets   String[] @default([])
}

model ServiceScopeGroup {
  id          String           @id @default(cuid())
  serviceId   String
  service     Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  size        ProjectScopeSize
  title       String
  description String
  order       Int              @default(0)

  @@index([serviceId, order])
}

// ===========================================================================
// Cursos
// ===========================================================================

model Course {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  headline          String
  headlineAccent    String
  subtitle          String
  duration          String
  moduleCount       Int      @default(4)
  description       String[] @default([])
  facilitiesIntro   String
  outcomesIntro     String
  trendsTitle       String   @default("Tendencias")
  isPublished       Boolean  @default(true)
  order             Int      @default(0)

  coverImageId String?
  coverImage   MediaAsset? @relation(fields: [coverImageId], references: [id], onDelete: SetNull)

  badges      CourseBadge[]
  highlights  CourseHighlight[]
  modules     CourseModule[]
  facilities  CourseFacility[]
  outcomes    CourseOutcome[]
  trends      CourseTrend[]
  enrollments Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseBadge {
  id          String  @id @default(cuid())
  courseId    String
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String
  icon        String  @default("practice")
  order       Int     @default(0)

  @@index([courseId, order])
}

model CourseHighlight {
  id          String @id @default(cuid())
  courseId    String
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String
  order       Int    @default(0)

  @@index([courseId, order])
}

model CourseModule {
  id          String @id @default(cuid())
  courseId    String
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  number      Int
  title       String
  duration    String
  description String
  order       Int    @default(0)

  @@index([courseId, order])
}

model CourseFacility {
  id        String     @id @default(cuid())
  courseId  String
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  mediaId   String?
  media     MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  order     Int        @default(0)

  @@index([courseId, order])
}

model CourseOutcome {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  order    Int    @default(0)

  @@index([courseId, order])
}

model CourseTrend {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  order    Int    @default(0)

  @@index([courseId, order])
}

// ===========================================================================
// Portafolio y prueba social
// ===========================================================================

model Client {
  id        String     @id @default(cuid())
  name      String
  shortName String
  category  String     @default("Educación")
  logoId    String?
  logo      MediaAsset? @relation(fields: [logoId], references: [id], onDelete: SetNull)
  websiteUrl String?
  order     Int        @default(0)
  isVisible Boolean    @default(true)

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model ProjectCategory {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  order    Int       @default(0)
  projects Project[]
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  description String[] @default([])
  year        Int?
  location    String?
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(true)
  order       Int      @default(0)

  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  categoryId String?
  category   ProjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  services   ServiceOnProject[]

  coverImageId String?
  coverImage   MediaAsset? @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  images       ProjectImage[]

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model ServiceOnProject {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceId String

  @@id([projectId, serviceId])
}

model ProjectImage {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaId   String
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  order     Int        @default(0)

  @@index([projectId, order])
}

model GalleryImage {
  id         String      @id @default(cuid())
  title      String
  category   String      @default("Instalaciones")
  mediaId    String
  media      MediaAsset  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  order      Int         @default(0)
  isVisible  Boolean     @default(true)

  @@index([order])
}

model Faq {
  id        String      @id @default(cuid())
  question  String
  answer    String
  category  String      @default("general")
  imageId   String?     @unique
  image     MediaAsset? @relation("FaqImage", fields: [imageId], references: [id], onDelete: SetNull)
  order     Int         @default(0)
  isVisible Boolean     @default(true)

  @@index([order])
}

model Testimonial {
  id       String      @id @default(cuid())
  author   String
  role     String?
  quote    String
  avatarId String?
  avatar   MediaAsset? @relation(fields: [avatarId], references: [id], onDelete: SetNull)
  order    Int         @default(0)
  isVisible Boolean    @default(true)

  @@index([order])
}

// ===========================================================================
// Prospectos (leads)
// ===========================================================================

enum LeadStatus {
  NUEVO
  EN_PROCESO
  ATENDIDO
  DESCARTADO
}

enum InquirySource {
  FORMULARIO_CONTACTO
  FORMULARIO_MATRICULA
  FORMULARIO_COTIZACION
  NAVBAR
  WHATSAPP
}

model ContactMessage {
  id        String        @id @default(cuid())
  fullName  String
  email     String
  phone     String
  company   String?
  message   String
  source    InquirySource @default(FORMULARIO_CONTACTO)
  status    LeadStatus    @default(NUEVO)
  serviceId String?
  service   Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  /** Servicio escrito a mano cuando el cliente no lo elige de la lista */
  serviceText String?
  ip        String?
  userAgent String?
  /** Correo de aviso enviado correctamente al equipo comercial */
  notified  Boolean       @default(false)
  notes     LeadNote[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

model Enrollment {
  id         String        @id @default(cuid())
  fullName   String
  email      String
  phone      String
  company    String?
  message    String?
  courseId   String?
  course     Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseText String?
  status     LeadStatus    @default(NUEVO)
  source     InquirySource @default(FORMULARIO_MATRICULA)
  ip         String?
  userAgent  String?
  notified   Boolean       @default(false)
  notes      LeadNote[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, createdAt])
}

model QuoteRequest {
  id          String        @id @default(cuid())
  fullName    String
  email       String
  phone       String
  company     String?
  projectType String?
  serviceId   String?
  serviceText String?
  budget      String?
  description String
  status      LeadStatus    @default(NUEVO)
  source      InquirySource @default(FORMULARIO_COTIZACION)
  ip          String?
  userAgent   String?
  notified    Boolean       @default(false)
  notes       LeadNote[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
}

/** Nota interna que el equipo agrega a un prospecto desde el panel. */
model LeadNote {
  id         String   @id @default(cuid())
  body       String
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  contactMessageId String?
  contactMessage   ContactMessage? @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
  enrollmentId     String?
  enrollment       Enrollment?     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  quoteRequestId   String?
  quoteRequest     QuoteRequest?   @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([contactMessageId])
  @@index([enrollmentId])
  @@index([quoteRequestId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}
