# ==========================================================================
# Sound Tech Perú — variables de entorno
# Copia este archivo a .env.local y completa los valores.
#
# NINGUNA variable es obligatoria para arrancar: el sitio funciona en modo
# demostración con el contenido base de src/content. Cada variable que añadas
# activa una capacidad nueva.
# ==========================================================================

# --- Base de datos (obligatoria para el panel de administración) -----------
# Neon (https://neon.tech) o la integración Postgres del Marketplace de Vercel.
# DATABASE_URL: endpoint con pooling (lleva "-pooler" en el host).
# DIRECT_URL:   endpoint directo, solo para migraciones.
DATABASE_URL="postgresql://usuario:clave@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://usuario:clave@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Autenticación del panel ----------------------------------------------
# Genera el secreto con:  npx auth secret
AUTH_SECRET=""
# URL pública; en Vercel se resuelve sola, en local hace falta.
# AUTH_URL="http://localhost:3000"

# --- Correo saliente (Resend) ---------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=""
# Remitente verificado. Mientras el dominio no esté verificado usa:
#   Sound Tech Perú <onboarding@resend.dev>
MAIL_FROM="Sound Tech Perú <no-reply@soundtechperu.com>"
# Buzón que recibe el aviso de cada nuevo prospecto.
ADMIN_NOTIFY_EMAIL="soundtechperu@gmail.com"

# --- Almacenamiento de imágenes (Vercel Blob) -----------------------------
# Vercel → Storage → Blob. Sin esta variable se usan los archivos de
# public/media, que es suficiente para el lanzamiento.
BLOB_READ_WRITE_TOKEN=""

# --- Antispam (Cloudflare Turnstile) --------------------------------------
# https://dash.cloudflare.com → Turnstile
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# --- Límite de envíos distribuido (Upstash Redis) -------------------------
# Sin esto el límite se aplica en memoria (suficiente en local, no entre
# instancias serverless). https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Asistente virtual (Google Gemini) -------------------------------------
# Clave gratuita de https://aistudio.google.com/apikey. Solo se usa en el
# servidor (nunca llega al navegador); sin ella el chat responde igual pero
# invitando a escribir por WhatsApp o el formulario.
# En Vercel se configura en Settings → Environment Variables → GEMINI_API_KEY.
GEMINI_API_KEY=""

# --- Sitio -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Solo para el script de seed ------------------------------------------
# Correo del primer administrador.
SEED_ADMIN_EMAIL="admin@soundtechperu.com"
# Contraseña del primer administrador. Si la dejas vacía, el seed genera una
# aleatoria y la imprime por pantalla una sola vez (recomendado).
SEED_ADMIN_PASSWORD=""
